---
import Base from "../layouts/Base.astro";
import { listEnrolments, TERM, termLabel } from "../lib/db";
import { currentStudent } from "../lib/session";

const student = currentStudent(Astro.cookies);
const record = student ? listEnrolments(student.id) : [];
const enrolled = record.filter((e) => e.status === "enrolled");
const completed = record.filter((e) => e.status === "completed");
const units = enrolled.reduce((total, e) => total + e.units, 0);
---

<Base title="My enrolment">
  <h1>My enrolment</h1>

  {
    !student ? (
      <p>
        <a href="/">Tell the app who you are</a> and your record will show up here.
      </p>
    ) : (
      <>
        <p>
          {student.name} · {student.uniId}
        </p>

        <h2>{termLabel(TERM.year, TERM.semester)}</h2>
        {enrolled.length === 0 ? (
          <p>
            Not enrolled in anything yet. <a href="/">Find a course</a>.
          </p>
        ) : (
          <>
            <p>
              {enrolled.length} {enrolled.length === 1 ? "course" : "courses"} · {units} units
            </p>
            <ul class="records">
              {enrolled.map((e) => (
                <li class="card">
                  <div class="card-head">
                    <span class="card-name">
                      <a class="code" href={`/courses/${e.code.toLowerCase()}/`}>
                        {e.code}
                      </a>{" "}
                      {e.title}
                    </span>
                    <span class="chip chip-enrolled">Enrolled</span>
                  </div>
                  <span class="meta">
                    {termLabel(e.year, e.semester)} · class number {e.classNumber} · {e.mode}
                  </span>
                  <form
                    method="post"
                    action="/api/drop"
                    onsubmit={`return confirm("Drop ${e.code}?")`}
                  >
                    <input type="hidden" name="courseCode" value={e.code} />
                    <input type="hidden" name="year" value={String(e.year)} />
                    <input type="hidden" name="semester" value={e.semester} />
                    <input type="hidden" name="returnTo" value="/me/" />
                    <button class="secondary">Drop {e.code}</button>
                  </form>
                </li>
              ))}
            </ul>
          </>
        )}

        <h2>Completed</h2>
        <p>
          What the requisite checks are reading. A real system would take this from your student
          record; this prototype has no record to read, so every new account starts from the same
          point in a degree.
        </p>
        {completed.length === 0 ? (
          <p>Nothing recorded.</p>
        ) : (
          <ul class="records">
            {completed.map((e) => (
              <li class="card">
                <div class="card-head">
                  <span class="card-name">
                    <a class="code" href={`/courses/${e.code.toLowerCase()}/`}>
                      {e.code}
                    </a>{" "}
                    {e.title}
                  </span>
                  <span class="chip chip-done">Completed</span>
                </div>
                <span class="meta">{termLabel(e.year, e.semester)}</span>
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }
</Base>
