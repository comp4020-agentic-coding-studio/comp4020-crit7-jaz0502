---
import Base from "../../layouts/Base.astro";
import {
  checkEligibility,
  findCourse,
  incompatibleWith,
  listOfferings,
  requirementGroups,
  TERM,
  termLabel,
} from "../../lib/db";
import { currentStudent } from "../../lib/session";
import { type Status, statusOf } from "../../lib/status";

const course = findCourse(Astro.params.code ?? "");
if (!course) return Astro.rewrite("/404");

const student = currentStudent(Astro.cookies);
const groups = requirementGroups(course.id);
const clashes = incompatibleWith(course.id);
const offerings = listOfferings(course.id);

// Only the enrolling term gets an eligibility verdict; the rest are listed so
// you can see the class numbers, but there's nothing to decide about them yet.
const rows = offerings.map((offering) => {
  const thisTerm = offering.year === TERM.year && offering.semester === TERM.semester;
  const eligibility = thisTerm && student ? checkEligibility(student.id, offering.id) : undefined;
  const status: Status = thisTerm
    ? statusOf(true, eligibility)
    : { label: "Other semester", tone: "closed" };
  return { offering, thisTerm, eligibility, status };
});
---

<Base title={`${course.code} ${course.title}`}>
  <h1>{course.code} {course.title}</h1>
  <p>{course.units} units</p>
  <p>{course.description}</p>

  <h2>Requisites</h2>
  <p>{course.requisiteText}</p>
  {
    groups.length > 0 && (
      <>
        <p>Of that, this app checks:</p>
        <ul>
          {groups.map((group) => (
            <li>
              {group.options.length === 1
                ? `You have completed ${group.options[0]?.code}`
                : `You have completed one of ${group.options.map((o) => o.code).join(", ")}`}
            </li>
          ))}
        </ul>
      </>
    )
  }
  {
    clashes.length > 0 && (
      <p>Incompatible with {clashes.map((c) => c.code).join(", ")} — you can't take both.</p>
    )
  }

  <h2>Offerings</h2>
  {
    rows.length === 0 ? (
      <p>
        Programs and Courses lists no offerings for this course at all right now — not just this
        semester. It's real, it's just not running.
      </p>
    ) : (
      <p>
        Every class number below is real, and you never need to read one. Enrolling takes the code
        and the semester; the app looks the rest up.
      </p>
    )
  }
  <ul class="records">
    {
      rows.map(({ offering, thisTerm, eligibility, status }) => (
        <li class="card">
          <div class="card-head">
            <span class="card-name">{termLabel(offering.year, offering.semester)}</span>
            <span class={`chip chip-${status.tone}`}>{status.label}</span>
          </div>
          <span class="meta">
            class number {offering.classNumber} · {offering.mode}
            {offering.lastDayToEnrol ? ` · enrol by ${offering.lastDayToEnrol}` : ""}
          </span>
          {!student ? (
            <p class="blocked">
              <a href="/">Tell the app who you are</a> to enrol.
            </p>
          ) : !thisTerm ? (
            <p class="blocked">
              Enrolment is open for {termLabel(TERM.year, TERM.semester)} only.
            </p>
          ) : eligibility?.ok ? (
            <form method="post" action="/api/enrol">
              <input type="hidden" name="courseCode" value={course.code} />
              <input type="hidden" name="year" value={String(offering.year)} />
              <input type="hidden" name="semester" value={offering.semester} />
              <button>Enrol in {course.code}</button>
            </form>
          ) : (
            <p class="blocked">{eligibility?.detail}</p>
          )}
        </li>
      ))
    }
  </ul>
</Base>
