---
// Every page's shell. The invariants require a lang, a viewport, a non-empty
// title, a nav landmark and exactly one h1 per page — keeping that in one
// place is how three pages stay consistent instead of drifting apart.
import "../styles.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const here = Astro.url.pathname;

const links = [
  { href: "/", label: "Enrol" },
  { href: "/me/", label: "My enrolment" },
  { href: "/readme/", label: "About" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="site">
      {
        links.map((link) => (
          <a href={link.href} aria-current={here === link.href ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
